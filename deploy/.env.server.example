# Copy to /opt/bustravel/<env>/.env on the server and fill in. File mode 600, owner deploy.
# One file per environment: staging and production use DIFFERENT secrets and DIFFERENT databases.

# --- deploy ---
IMAGE_PREFIX=ghcr.io/<github-owner>/bus-travel
DOMAIN=staging.example.com

# --- database ---
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24

# --- API ---
WEB_URL=https://staging.example.com
JWT_ACCESS_SECRET=generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=generate-with-openssl-rand-hex-32
TICKET_SECRET=generate-with-openssl-rand-hex-32
# staging may keep the demo checkout (mock); production MUST use stripe (the API refuses to start otherwise)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENABLE_SWAGGER=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="BusTravel <no-reply@example.com>"
