{
  "version": 2,
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "npm run build && mkdir -p public && echo ok > public/health.txt",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "includeFiles": "dist/**", "maxDuration": 30 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
