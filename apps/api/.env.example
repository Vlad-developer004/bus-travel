# --- API (apps/api) ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bustravel
WEB_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long-xxxx
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long-xxx
TICKET_SECRET=change-me-ticket-min-32-chars-long-xxxxx
COOKIE_SECURE=false
# mock = local demo checkout page, stripe = real Stripe Checkout (test keys)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Empty SMTP_HOST = emails are only logged
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="BusTravel <no-reply@bustravel.local>"
INTERNAL_CRON_SECRET=
ALLOW_MOCK_PAYMENTS=
